APP_NAME="Mini Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — same `mysql` driver for both environments; only the values differ.
# ---------------------------------------------------------------------------
# Local (MySQL 8 via docker-compose) — these defaults match docker-compose.yml:
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=booking
DB_USERNAME=booking
DB_PASSWORD=secret
# Empty → no TLS locally. config/database.php drops it via array_filter().
MYSQL_ATTR_SSL_CA=

# Production (TiDB Cloud Serverless) — set these in your host's env, do NOT commit:
# DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
# DB_PORT=4000                                          # TiDB uses 4000, not 3306
# DB_DATABASE=test
# DB_USERNAME=<prefix>.root                             # username is prefixed
# DB_PASSWORD=<password>
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt  # OS CA bundle enables TLS

# Caching/queue/session are out of scope — kept off the database driver.
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
